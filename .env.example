# GitHub Auto Error Reporting Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Enable automatic GitHub issue creation from errors
GITHUB_ISSUE_REPORTER_ENABLED=false

# GitHub personal access token (requires 'repo' or 'public_repo' scope)
# Get one from: https://github.com/settings/tokens
GITHUB_TOKEN=

# Repository to create issues in (format: owner/repo)
GITHUB_REPOSITORY=endomorphosis/hallucinate_app

# Minimum error level to report (debug, info, warning, error, fatal)
GITHUB_ISSUE_MIN_LEVEL=error

# Maximum number of issues to create per hour
GITHUB_ISSUE_RATE_LIMIT=10

# Time window in hours to check for duplicate errors
GITHUB_ISSUE_DUPLICATE_WINDOW=24

# Comma-separated list of labels to add to issues
GITHUB_ISSUE_LABELS=auto-reported,bug

# Comma-separated list of GitHub usernames to assign issues to
GITHUB_ISSUE_ASSIGNEES=

# Auto-assign issues (true/false)
GITHUB_ISSUE_AUTO_ASSIGN=false

# Include stack traces in reports (true/false)
GITHUB_ISSUE_INCLUDE_STACK=true

# Include system info in reports (true/false)
GITHUB_ISSUE_INCLUDE_SYSTEM_INFO=true

# Dry run mode - log instead of creating issues (true/false)
GITHUB_ISSUE_DRY_RUN=false
