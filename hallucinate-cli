#!/usr/bin/env node

/**
 * Hallucinate App CLI
 * Command-line interface for managing the Hallucinate Electron application
 */

import { spawn } from 'child_process';
import path from 'path';
import fs from 'fs';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const APP_DIR = __dirname;
const ELECTRON_PATH = path.join(APP_DIR, 'node_modules', '.bin', 'electron');
const LOG_FILE = '/tmp/hallucinate-app.log';

const commands = {
  start: {
    description: 'Start the Hallucinate Electron app',
    action: startApp
  },
  stop: {
    description: 'Stop the Hallucinate Electron app',
    action: stopApp
  },
  restart: {
    description: 'Restart the Hallucinate Electron app',
    action: restartApp
  },
  status: {
    description: 'Check if the app is running',
    action: checkStatus
  },
  logs: {
    description: 'View application logs',
    action: viewLogs
  },
  debug: {
    description: 'View debug logs with errors highlighted',
    action: viewDebugLogs
  },
  tail: {
    description: 'Tail debug logs in real-time',
    action: tailLogs
  },
  help: {
    description: 'Show this help message',
    action: showHelp
  }
};

function startApp() {
  console.log('🚀 Starting Hallucinate Electron app...');
  
  const electron = spawn(ELECTRON_PATH, ['--no-sandbox', '.'], {
    cwd: APP_DIR,
    detached: true,
    stdio: ['ignore', 'pipe', 'pipe'],
    env: { ...process.env, ELECTRON_ENABLE_LOGGING: '1' }
  });
  
  const logStream = fs.createWriteStream(LOG_FILE, { flags: 'a' });
  electron.stdout.pipe(logStream);
  electron.stderr.pipe(logStream);
  
  electron.on('spawn', () => {
    console.log(`✅ Electron app started (PID: ${electron.pid})`);
    console.log(`📝 Logs: ${LOG_FILE}`);
    console.log(`🐛 Debug logs: /tmp/hallucinate-app-debug.log`);
    electron.unref();
    process.exit(0);
  });
  
  electron.on('error', (err) => {
    console.error('❌ Failed to start Electron app:', err.message);
    process.exit(1);
  });
}

function stopApp() {
  console.log('🛑 Stopping Hallucinate Electron app...');
  
  // First try to find electron processes from this directory
  const pgrep = spawn('pgrep', ['-f', 'electron.*--no-sandbox']);
  let pids = '';
  
  pgrep.stdout.on('data', (data) => {
    pids += data.toString();
  });
  
  pgrep.on('close', (code) => {
    if (pids.trim()) {
      const pidList = pids.trim().split('\n');
      console.log(`Found ${pidList.length} Electron processes to stop...`);
      
      // Kill all found processes
      const kill = spawn('kill', ['-15', ...pidList]);
      
      kill.on('close', (killCode) => {
        // Give processes time to cleanup
        setTimeout(() => {
          // Force kill any remaining
          spawn('kill', ['-9', ...pidList]).on('close', () => {
            console.log('✅ Electron app stopped');
            process.exit(0);
          });
        }, 1000);
      });
    } else {
      console.log('ℹ️  No running Electron processes found');
      process.exit(0);
    }
  });
}

function restartApp() {
  console.log('🔄 Restarting Hallucinate Electron app...');
  
  // Use the improved stop logic
  const pgrep = spawn('pgrep', ['-f', 'electron.*--no-sandbox']);
  let pids = '';
  
  pgrep.stdout.on('data', (data) => {
    pids += data.toString();
  });
  
  pgrep.on('close', (code) => {
    if (pids.trim()) {
      const pidList = pids.trim().split('\n');
      // Force kill for faster restart
      const kill = spawn('kill', ['-9', ...pidList]);
      
      kill.on('close', () => {
        setTimeout(() => {
          startApp();
        }, 2000);
      });
    } else {
      // No processes running, just start
      setTimeout(() => {
        startApp();
      }, 1000);
    }
  });
}

function checkStatus() {
  const pgrep = spawn('pgrep', ['-a', '-f', 'electron.*--no-sandbox']);
  let output = '';
  
  pgrep.stdout.on('data', (data) => {
    output += data.toString();
  });
  
  pgrep.on('close', (code) => {
    if (code === 0 && output.trim()) {
      const lines = output.split('\n').filter(line => line.trim());
      console.log('✅ Hallucinate Electron app is running:');
      lines.forEach(line => {
        if (line.trim()) {
          console.log(`   ${line}`);
        }
      });
    } else {
      console.log('❌ Hallucinate Electron app is not running');
    }
    process.exit(0);
  });
}

function viewLogs() {
  if (fs.existsSync(LOG_FILE)) {
    const tail = spawn('tail', ['-50', LOG_FILE]);
    tail.stdout.pipe(process.stdout);
    tail.stderr.pipe(process.stderr);
    tail.on('close', () => process.exit(0));
  } else {
    console.log('📝 No logs found at', LOG_FILE);
    process.exit(1);
  }
}

function viewDebugLogs() {
  const DEBUG_LOG = '/tmp/hallucinate-app-debug.log';
  if (fs.existsSync(DEBUG_LOG)) {
    console.log(`\n📋 Debug Log: ${DEBUG_LOG}\n`);
    const cat = spawn('cat', [DEBUG_LOG]);
    cat.stdout.pipe(process.stdout);
    cat.stderr.pipe(process.stderr);
    cat.on('close', () => process.exit(0));
  } else {
    console.log('📝 No debug logs found. The app may not have encountered any errors yet.');
    console.log(`   Expected location: ${DEBUG_LOG}`);
    process.exit(1);
  }
}

function tailLogs() {
  const DEBUG_LOG = '/tmp/hallucinate-app-debug.log';
  console.log(`\n📡 Tailing debug log: ${DEBUG_LOG}`);
  console.log('Press Ctrl+C to stop\n');
  
  // Create file if it doesn't exist
  if (!fs.existsSync(DEBUG_LOG)) {
    fs.writeFileSync(DEBUG_LOG, '');
  }
  
  const tail = spawn('tail', ['-f', DEBUG_LOG]);
  tail.stdout.pipe(process.stdout);
  tail.stderr.pipe(process.stderr);
  
  process.on('SIGINT', () => {
    tail.kill();
    console.log('\n\n✅ Stopped tailing logs');
    process.exit(0);
  });
}

function showHelp() {
  console.log('\n🎨 Hallucinate App CLI\n');
  console.log('Usage: hallucinate-cli <command>\n');
  console.log('Commands:');
  
  Object.entries(commands).forEach(([cmd, { description }]) => {
    console.log(`  ${cmd.padEnd(12)} ${description}`);
  });
  
  console.log('\nExamples:');
  console.log('  hallucinate-cli start      # Start the app');
  console.log('  hallucinate-cli restart    # Restart the app');
  console.log('  hallucinate-cli status     # Check if running');
  console.log('  hallucinate-cli logs       # View recent logs');
  console.log('');
  process.exit(0);
}

// Main execution
const command = process.argv[2] || 'help';

if (commands[command]) {
  commands[command].action();
} else {
  console.error(`❌ Unknown command: ${command}`);
  console.log('Run "hallucinate-cli help" for usage information');
  process.exit(1);
}
