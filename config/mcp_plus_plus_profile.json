      "interface_cid",
      "surface",
      "input_contract",
      "output_contract",
      "state_contract",
      "event_contracts",
      "required_capabilities"
    ],
    "requirements": [
      "descriptors must be content-addressed and retrievable by CID",
      "descriptors must be treated as untrusted input and schema-validated before use",
      "descriptors must not grant authority without matching UCAN proofs",
      "descriptor packs must declare source repository, version, and service ownership",
      "descriptor changes that alter method inputs, outputs, errors, or capabilities must produce a new interface_cid"
    ]
  },
