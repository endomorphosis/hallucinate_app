  "conformance": {
    "offlineRequired": true,
    "liveNetworkRequired": false,
    "minimumChecks": [
      "JSON parses with python -m json.tool",
      "all serviceRequirements entries declare transport-compatible descriptors",
      "all serviceRequirements entries include IDL, envelope, UCAN, event DAG, and scheduler profiles",
      "descriptorRequiredFields include MCP-IDL required fields",
      "executionEnvelopeRequiredFields include interface_cid, input_cid, intent_cid, and parents",
      "UCAN validation requires execution-time proof checks and revocation checks",
      "eventDag event node fields include parents and receipt binding",
      "scheduler requirements include dependency readiness and resource accounting"
    ]
